<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_five_five_commercial_invoice_line_convert_wizard_form" model="ir.ui.view">
		<field name="name">five.five.commercial.invoice.line.convert.wizard.form</field>
		<field name="model">five.five.commercial.invoice.line.convert.wizard</field>
		<field name="arch" type="xml">
			<form string="Convert to Product">
				<group string="Invoice Line">
					<group>
						<field name="commercial_invoice_line_id" invisible="1"/>
						<field name="commercial_invoice_line_name" readonly="1"/>
					</group>
					<group>
						<field name="commercial_invoice_unit_id" readonly="1"/>
						<field name="commercial_invoice_size_id" readonly="1"/>
						<field name="commercial_invoice_grade_id" readonly="1"/>
						<field name="commercial_invoice_quantity" readonly="1"/>
					</group>
				</group>
				<group string="Weight Summary">
					<field name="commercial_invoice_total_weight" readonly="1"/>
					<field name="converted_total_weight" readonly="1"/>
					<field name="weight_diff" readonly="1" decoration-danger="weight_diff != 0"/>
					<field name="price_diff_usd" readonly="1" string="Price Diff" decoration-danger="weight_diff != 0"/>
				</group>
				<group string="Products to convert">
					<field name="convert_line_ids">
						<list editable="bottom" class="ff_list_wide_headers">
							<field name="convert_date" string="Date" width="110px"/>
							<field name="product_variant_id" string="product" width="240px"/>
							<field name="lot_number" string="Lot No." width="130px"/>
							<field name="container_number" string="Container No." width="130px" required="1"/>
							<field name="item_number" string="item" width="80px"/>
							<field name="description_id" string="Description" width="260px"/>
							<field name="brand_id" string="Brand" width="180px"/>
							<field name="size_name" string="Size" width="100px"/>
							<field name="size_id" column_invisible="1"/>
							<field name="quantity" string="QTY" width="90px"/>
							<field name="weight_per_qty" string="Weight/Qty" width="110px"/>
							<field name="total_weight" string="Weight (Kg.)" width="120px" readonly="1"/>
							<field name="quality_note" string="Quality Note" width="140px"/>
							<field name="quality_image" widget="image" string="Quality Image"/>
						</list>
					</field>
				</group>
				<footer>
					<button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
					<button special="cancel" string="Cancel" class="btn-secondary"/>
				</footer>
			</form>
		</field>
	</record>
</odoo>
