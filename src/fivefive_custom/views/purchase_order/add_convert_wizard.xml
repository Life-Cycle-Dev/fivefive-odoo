<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_five_five_purchase_order_add_convert_wizard_form" model="ir.ui.view">
        <field name="name">five.five.purchase.order.add.convert.wizard.form</field>
        <field name="model">five.five.purchase.order.add.convert.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Converted Product">
                <group>
                    <field name="purchase_order_id" readonly="1"/>
                    <field name="product_variant_id" string="product" required="1"/>
                    <field name="convert_date" string="Date"/>
                    <field name="lot_number" string="Lot No."/>
                    <field name="item_number" string="item"/>
                    <field name="description_id" string="Description"/>
                    <field name="brand_id" string="Brand"/>
                    <field name="container_number" string="Sub Lot"/>
                    <field name="size_name" string="Size" readonly="1"/>
                    <field name="size_id" invisible="1"/>
                    <field name="quantity" string="QTY" required="1"/>
                    <field name="weight_per_qty" string="Weight/Qty"/>
                    <field name="quality_note" required="1"/>
                    <field name="quality_image" widget="image"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Add" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
