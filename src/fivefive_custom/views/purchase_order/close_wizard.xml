<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_five_five_purchase_order_close_wizard_form" model="ir.ui.view">
        <field name="name">five.five.purchase.order.close.wizard.form</field>
        <field name="model">five.five.purchase.order.close.wizard</field>
        <field name="arch" type="xml">
            <form string="Close PO">
                <group>
                    <group>
                        <field name="purchase_order_id" readonly="1"/>
                        <field name="warehouse_id" readonly="1"/>
                        <field name="lot_number" placeholder="Enter lot number for all products..."/>
                    </group>
                    <group>
                        <field name="as_of_date" readonly="1"/>
                    </group>
                </group>
                <group string="Converted Products">
                    <field name="line_ids" nolabel="1" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="product_variant_id"/>
                            <field name="quantity"/>
                            <field name="quality_note"/>
                            <field name="cost_summary"/>
                            <field name="total_cost_thb"/>
                        </list>
                    </field>
                </group>
                <group>
                    <field name="total_cost_thb_display" nolabel="1" readonly="1" colspan="2"/>
                    <field name="total_cost_thb" invisible="1"/>
                    <field name="max_supplier_credit_usd" invisible="1"/>
                </group>
                <group string="Supplier Credit">
                    <field name="supplier_credit_amount_usd" placeholder="Optional credit for next PO..."/>
                    <field name="supplier_credit_amount_thb" readonly="1"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Close PO" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
