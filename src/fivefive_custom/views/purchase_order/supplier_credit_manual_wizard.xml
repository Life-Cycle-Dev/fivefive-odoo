<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_five_five_supplier_credit_manual_wizard_form" model="ir.ui.view">
        <field name="name">five.five.supplier.credit.manual.wizard.form</field>
        <field name="model">five.five.supplier.credit.manual.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Manual Supplier Credit">
                <group>
                    <field name="supplier_id" readonly="1"/>
                    <field name="amount_usd"/>
                    <field name="amount_thb"/>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
