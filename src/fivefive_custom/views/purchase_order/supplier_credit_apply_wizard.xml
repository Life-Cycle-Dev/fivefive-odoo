<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_five_five_supplier_credit_apply_wizard_form" model="ir.ui.view">
        <field name="name">five.five.supplier.credit.apply.wizard.form</field>
        <field name="model">five.five.supplier.credit.apply.wizard</field>
        <field name="arch" type="xml">
            <form string="Apply Supplier Credit">
                <group>
                    <field name="purchase_order_id" readonly="1"/>
                    <field name="supplier_id" readonly="1"/>
                    <field name="is_thailand_po" invisible="1"/>
                    <field name="available_credit_usd" readonly="1" string="Available Credit (THB)" invisible="not is_thailand_po"/>
                    <field name="available_credit_usd" readonly="1" string="Available Credit (USD)" invisible="is_thailand_po"/>
                    <field name="remaining_po_usd" readonly="1" string="Remaining PO Amount (THB)" invisible="not is_thailand_po"/>
                    <field name="remaining_po_usd" readonly="1" string="Remaining PO Amount (USD)" invisible="is_thailand_po"/>
                    <field name="apply_amount_usd" string="Apply Amount (THB)" invisible="not is_thailand_po"/>
                    <field name="apply_amount_usd" string="Apply Amount (USD)" invisible="is_thailand_po"/>
                </group>
                <group>
                    <field name="credit_summary" nolabel="1" readonly="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Apply Credit" class="btn-primary"/>
                    <button name="action_skip" type="object" string="Skip" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
