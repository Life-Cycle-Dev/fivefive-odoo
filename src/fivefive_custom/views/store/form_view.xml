<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_five_five_store_model_form" model="ir.ui.view">
        <field name="name">five.five.store.form</field>
        <field name="model">five.five.store</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_open_transfer_wizard"
                        type="object"
                        string="Transfer to Store"
                        class="btn-primary"
                    />
                    <button
                        name="action_open_convert_product_wizard"
                        type="object"
                        string="Convert Product"
                        class="btn-secondary"
                    />
                    <button
                        name="action_open_inventory_adjust_wizard"
                        type="object"
                        string="Adjust Inventory"
                        class="btn-secondary"
                        invisible="not store_inventory_ids"
                    />
                    <button
                        name="action_open_pos"
                        type="object"
                        string="Open POS"
                        class="btn-secondary"
                    />
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <div class="oe_title">
                                <div class="text-muted" invisible="name == '' or not name">Store</div>
                                <h1 invisible="not active or name == '' or not name">
                                    <field name="name" readonly="1"/>
                                </h1>
                                <h1 class="text-decoration-line-through text-muted" invisible="active or name == '' or not name">
                                    <field name="name" readonly="1"/>
                                </h1>
                            </div>
                        </group>
                        <group>
                            <field nolabel="1" name="image" widget="image" class="oe_avatar" options="{'size': [128, 128]}"/>
                        </group>
                    </group>
                    
                    <group string="General Information">
                        <field name="name"/>
                        <field name="phone"/>
                    </group>

                    <group string="Receipt Header">
                        <field name="branch_subtitle" placeholder="e.g. ซีคอนสแควร์ ศรีนครินทร์"/>
                        <field name="receipt_company_name"/>
                        <field name="branch_code" placeholder="00000"/>
                        <field name="tax_id"/>
                        <field name="address" placeholder="ที่อยู่สำหรับพิมพ์บนใบเสร็จ"/>
                    </group>

                    <group string="Receipt VAT">
                        <field name="pos_vat_included"/>
                        <field name="pos_vat_percent" invisible="not pos_vat_included"/>
                    </group>

                    <group string="Store Inventory">
                        <field name="store_inventory_ids" nolabel="1">
                            <list create="0" edit="bottom" delete="0" no_open="1">
                                <field name="product_variant_id" string="Product Variant" width="160px" readonly="1"/>
                                <field name="sell_price_thb" string="Sell Price (THB)" width="120px"/>
                                <field name="lot_number" string="Lot Number" width="150px" readonly="1"/>
                                <field name="quantity" string="Quantity" width="90px" readonly="1"/>
                                <field name="weight_per_qty" string="Weight/Qty" width="100px" readonly="1"/>
                                <field name="total_weight" string="Weight (Kg.)" width="110px" readonly="1"/>
                                <field name="quality_note" string="Quality Note" width="120px" readonly="1"/>
                                <field name="cost_summary" string="Cost Summary" width="280px" readonly="1"/>
                                <field name="total_cost_thb" string="Total Cost (THB)" width="150px" readonly="1"/>
                                <field name="cost_as_of_date" string="Cost Frozen On" width="120px" readonly="1"/>
                                <field name="purchase_order_id" string="Purchase Order" width="150px" readonly="1"/>
                            </list>
                        </field>
                        <group class="mt-2">
                            <field name="store_inventory_total_cost_thb" readonly="1"/>
                        </group>
                    </group>

                    <group string="POS Users">
                        <field name="pos_user_ids" nolabel="1" context="{'default_store_id': id}">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="username"/>
                                <field name="password_plain" password="True" string="Password"/>
                                <field name="tab_pos" optional="hide"/>
                                <field name="tab_requisition" optional="hide"/>
                                <field name="tab_requisition_history" optional="hide"/>
                                <field name="tab_stock" optional="hide"/>
                                <field name="tab_sales" optional="hide"/>
                                <field name="tab_close_session" optional="hide"/>
                                <field name="active"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids" options="{'post_refresh': 'recipients'}"/>
                </chatter>
            </form>
        </field>
    </record>

    <record id="action_five_five_store_model" model="ir.actions.act_window">
        <field name="name">Store</field>
        <field name="res_model">five.five.store</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>