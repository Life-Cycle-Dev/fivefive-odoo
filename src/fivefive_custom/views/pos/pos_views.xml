<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_five_five_store_pos_user_credential_wizard_form" model="ir.ui.view">
        <field name="name">five.five.store.pos.user.credential.wizard.form</field>
        <field name="model">five.five.store.pos.user.credential.wizard</field>
        <field name="arch" type="xml">
            <form string="POS Credentials">
                <group>
                    <field name="pos_user_id" invisible="1"/>
                    <field name="is_suggestion" invisible="1"/>
                    <field name="username" readonly="1"/>
                    <field name="password" readonly="1"/>
                </group>
                <footer>
                    <button name="action_apply_password" type="object" string="Use This Password" class="btn-primary" invisible="not is_suggestion"/>
                    <button special="cancel" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_five_five_store_pos_user_change_password_wizard_form" model="ir.ui.view">
        <field name="name">five.five.store.pos.user.change.password.wizard.form</field>
        <field name="model">five.five.store.pos.user.change.password.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Password">
                <group>
                    <field name="pos_user_id" invisible="1"/>
                    <field name="new_password" password="True"/>
                    <field name="confirm_password" password="True"/>
                </group>
                <footer>
                    <button name="action_change_password" type="object" string="Change Password" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_five_five_store_pos_user_list" model="ir.ui.view">
        <field name="name">five.five.store.pos.user.list</field>
        <field name="model">five.five.store.pos.user</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="username"/>
                <field name="store_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_five_five_store_pos_user_form" model="ir.ui.view">
        <field name="name">five.five.store.pos.user.form</field>
        <field name="model">five.five.store.pos.user</field>
        <field name="arch" type="xml">
            <form string="POS User">
                <header>
                    <button name="action_change_password" type="object" string="Change Password" class="btn-primary"/>
                    <button name="action_generate_password" type="object" string="Suggest Password" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Display Name"/></h1>
                    </div>
                    <group>
                        <group string="Account">
                            <field name="store_id"/>
                            <field name="username"/>
                            <field name="password_plain" password="True" placeholder="Set login password"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_five_five_store_pos_session_list" model="ir.ui.view">
        <field name="name">five.five.store.pos.session.list</field>
        <field name="model">five.five.store.pos.session</field>
        <field name="arch" type="xml">
            <list default_order="opened_at desc">
                <field name="store_id"/>
                <field name="pos_user_id"/>
                <field name="state" widget="badge" decoration-success="state == 'open'" decoration-muted="state == 'closed'"/>
                <field name="total_sales" sum="Total Sales"/>
                <field name="order_count" string="Orders"/>
                <field name="opened_at"/>
                <field name="closed_at" optional="hide"/>
                <field name="opening_cash" optional="hide"/>
                <field name="closing_cash" optional="hide"/>
                <field name="cash_difference" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_five_five_store_pos_session_form" model="ir.ui.view">
        <field name="name">five.five.store.pos.session.form</field>
        <field name="model">five.five.store.pos.session</field>
        <field name="arch" type="xml">
            <form string="POS Session" create="0" edit="0" delete="0">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="open,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Session">
                            <field name="store_id" readonly="1"/>
                            <field name="pos_user_id" readonly="1"/>
                            <field name="opened_at" readonly="1"/>
                            <field name="closed_at" readonly="1"/>
                        </group>
                        <group string="Summary">
                            <field name="order_count" readonly="1"/>
                            <field name="total_sales" readonly="1"/>
                        </group>
                    </group>
                    <group string="Cash" invisible="state != 'closed'">
                        <group>
                            <field name="opening_cash" readonly="1"/>
                            <field name="expected_cash" readonly="1"/>
                            <field name="closing_cash" readonly="1"/>
                        </group>
                        <group>
                            <field name="cash_difference" readonly="1"/>
                        </group>
                    </group>
                    <group string="Cash" invisible="state != 'open'">
                        <field name="opening_cash" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Orders">
                            <field name="order_ids" readonly="1">
                                <list>
                                    <field name="number"/>
                                    <field name="order_date"/>
                                    <field name="total"/>
                                    <field name="state" widget="badge" decoration-success="state == 'done'" decoration-muted="state == 'cancelled'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_five_five_store_pos_order_list" model="ir.ui.view">
        <field name="name">five.five.store.pos.order.list</field>
        <field name="model">five.five.store.pos.order</field>
        <field name="arch" type="xml">
            <list default_order="order_date desc" create="0" delete="0">
                <field name="number"/>
                <field name="order_date"/>
                <field name="store_id"/>
                <field name="pos_user_id"/>
                <field name="total" sum="Total"/>
                <field name="payment_method" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-muted="state == 'cancelled'"/>
                <field name="discount_amount" optional="hide"/>
                <field name="session_id" optional="hide"/>
                <field name="cancelled_at" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_five_five_store_pos_order_form" model="ir.ui.view">
        <field name="name">five.five.store.pos.order.form</field>
        <field name="model">five.five.store.pos.order</field>
        <field name="arch" type="xml">
            <form string="POS Order" create="0" edit="0" delete="0">
                <header>
                    <button
                        name="action_print_receipt"
                        type="object"
                        string="พิมพ์ใบเสร็จ"
                        class="btn-primary"
                        invisible="state != 'done'"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="number" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Order">
                            <field name="order_date" readonly="1"/>
                            <field name="store_id" readonly="1"/>
                            <field name="pos_user_id" readonly="1"/>
                            <field name="session_id" readonly="1"/>
                        </group>
                        <group string="Payment">
                            <field name="payment_method" readonly="1"/>
                            <field name="subtotal" readonly="1"/>
                            <field name="discount_type" readonly="1" invisible="not discount_amount"/>
                            <field name="discount_value" readonly="1" invisible="not discount_amount"/>
                            <field name="discount_amount" readonly="1" invisible="not discount_amount"/>
                            <field name="total" readonly="1"/>
                            <field name="amount_paid" readonly="1"/>
                            <field name="change_amount" readonly="1"/>
                            <field name="transfer_slip" readonly="1" widget="image" invisible="payment_method != 'transfer'"/>
                            <field name="transfer_slip_filename" invisible="1"/>
                        </group>
                    </group>
                    <group string="Cancellation" invisible="state != 'cancelled'">
                        <field name="return_stock" readonly="1"/>
                        <field name="cancel_reason" readonly="1"/>
                        <field name="cancelled_at" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Items">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="product_variant_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal" sum="Subtotal"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_five_five_store_pos_user" model="ir.actions.act_window">
        <field name="name">POS Users</field>
        <field name="res_model">five.five.store.pos.user</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_five_five_store_pos_session" model="ir.actions.act_window">
        <field name="name">POS Sessions</field>
        <field name="res_model">five.five.store.pos.session</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_five_five_store_pos_order" model="ir.actions.act_window">
        <field name="name">POS Orders</field>
        <field name="res_model">five.five.store.pos.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_open_store_pos" model="ir.actions.act_url">
        <field name="name">Open POS</field>
        <field name="url">/pos</field>
        <field name="target">new</field>
    </record>
</odoo>
