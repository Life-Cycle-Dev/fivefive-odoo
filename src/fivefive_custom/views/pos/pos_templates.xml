<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="store_pos_app" name="Store POS App">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"/>
                <title>ระบบขายหน้าร้าน</title>
                <link rel="preconnect" href="https://fonts.googleapis.com"/>
                <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
                <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&amp;family=Noto+Sans+Thai:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
                <link rel="stylesheet" href="/fivefive_custom/static/src/pos/pos.css?v=1.0.34"/>
            </head>
            <body>
                <div id="pos-app">
                    <!-- เข้าสู่ระบบ -->
                    <section id="screen-login" class="pos-screen pos-auth-screen active">
                        <div class="pos-auth-card">
                            <div class="pos-brand">
                                <h1>ระบบขายหน้าร้าน</h1>
                                <p>เข้าสู่ระบบเพื่อเริ่มขาย</p>
                            </div>
                            <div id="login-error" class="pos-error" hidden="hidden"></div>
                            <form id="login-form">
                                <div class="pos-field">
                                    <label class="pos-label" for="login-username">ชื่อผู้ใช้</label>
                                    <input id="login-username" class="pos-input" type="text" autocomplete="username" required="required"/>
                                </div>
                                <div class="pos-field">
                                    <label class="pos-label" for="login-password">รหัสผ่าน</label>
                                    <input id="login-password" class="pos-input" type="password" autocomplete="current-password" required="required"/>
                                </div>
                                <button class="pos-btn pos-btn-primary pos-btn-block" type="submit">เข้าสู่ระบบ</button>
                            </form>
                        </div>
                    </section>

                    <!-- เปิดกะ -->
                    <section id="screen-open-session" class="pos-screen pos-auth-screen">
                        <div class="pos-auth-card">
                            <div class="pos-brand">
                                <div class="pos-brand-badge">฿</div>
                                <h1>เปิดกะขาย</h1>
                                <p>กรอกเงินทอนเริ่มต้นในลิ้นชัก</p>
                            </div>
                            <div id="open-session-error" class="pos-error" hidden="hidden"></div>
                            <form id="open-session-form">
                                <div class="pos-field">
                                    <label class="pos-label" for="opening-cash">เงินสดเริ่มต้น (บาท)</label>
                                    <input id="opening-cash" class="pos-input" type="number" min="0" step="0.01" value="0"/>
                                </div>
                                <button class="pos-btn pos-btn-primary pos-btn-block" type="submit">เปิดกะ</button>
                            </form>
                        </div>
                    </section>

                    <!-- 1. ตะกร้าสินค้า -->
                    <section id="screen-pos" class="pos-screen">
                        <div class="pos-header-bar">
                            <div class="pos-header-left">
                                <button class="pos-icon-btn pos-menu-btn" type="button" title="เมนู" aria-label="เมนู">
                                    <svg class="pos-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
                                </button>
                                <div>
                                    <div class="pos-header-title" id="pos-store-name">ร้านค้า</div>
                                    <small><span id="pos-user-name">พนักงาน</span> · กะ <span id="pos-session-badge">-</span></small>
                                </div>
                            </div>
                        </div>
                        <div id="no-session-banner" class="pos-session-banner" hidden="hidden">ยังไม่ได้เปิดกะ — ไม่สามารถขายได้ กรุณาเปิดกะจากเมนู</div>
                        <div class="pos-workspace">
                            <div class="pos-left-panel">
                                <div class="pos-search-box">
                                    <input id="product-search" class="pos-search-input" type="search" placeholder="ค้นหาสินค้า รหัส หรือบาร์โค้ด"/>
                                </div>
                                <div class="pos-product-area">
                                    <div id="product-grid" class="pos-product-grid"></div>
                                </div>
                                <div id="products-pagination" class="pos-pagination" hidden="hidden"></div>
                                <div class="pos-barcode-bar">
                                    <button id="barcode-scan-btn" class="pos-barcode-scan-btn" type="button" aria-label="สแกนบาร์โค้ด" title="สแกนบาร์โค้ด">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><line x1="7" y1="12" x2="17" y2="12"/></svg>
                                    </button>
                                    <input id="barcode-input" type="text" placeholder="สแกนบาร์โค้ด" autocomplete="off"/>
                                    <button id="barcode-add-btn" type="button">เพิ่ม</button>
                                </div>
                            </div>
                            <div class="pos-right-panel">
                                <div class="pos-cart-head pos-cart-head--editable">
                                    <span>จำนวน</span>
                                    <span>รายการ</span>
                                    <span class="pos-cart-head-price">ราคา</span>
                                    <span class="pos-cart-head-spacer"></span>
                                </div>
                                <div id="cart-list" class="pos-cart-body js-cart-table-body"></div>
                                <div class="pos-summary-box">
                                    <div class="pos-summary-row">
                                        <span>รายการ (<span class="js-summary-items">0</span>)</span>
                                        <span class="js-summary-subtotal">0.00</span>
                                    </div>
                                    <div class="pos-summary-row grand">
                                        <span>ยอดรวม</span>
                                        <span class="js-summary-total">0.00</span>
                                    </div>
                                </div>
                                <button id="checkout-btn" class="pos-primary-btn" type="button" disabled="disabled">ต่อไป</button>
                            </div>
                        </div>
                    </section>

                    <!-- 2. เงื่อนไขการชำระ -->
                    <section id="screen-discount" class="pos-screen">
                        <div class="pos-header-bar">
                            <div class="pos-header-left">
                                <button class="pos-icon-btn pos-menu-btn" type="button" title="เมนู" aria-label="เมนู">
                                    <svg class="pos-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
                                </button>
                                <div class="pos-header-title">2. เงื่อนไขการชำระ</div>
                            </div>
                        </div>
                        <div class="pos-workspace">
                            <div class="pos-left-panel">
                                <div class="pos-panel-section">
                                    <label class="pos-label" for="discount-type">ประเภทส่วนลด</label>
                                    <select id="discount-type" class="pos-select">
                                        <option value="percent">ส่วนลด (%)</option>
                                        <option value="fixed">ส่วนลด (บาท)</option>
                                    </select>
                                </div>
                                <div class="pos-panel-section">
                                    <label class="pos-label" for="discount-value">จำนวนส่วนลด</label>
                                    <input id="discount-value" class="pos-input" type="number" min="0" step="0.01" value="0" placeholder="0"/>
                                </div>
                                <div class="pos-panel-section">
                                    <label class="pos-label" for="order-note">หมายเหตุ</label>
                                    <input id="order-note" class="pos-input" type="text" placeholder="หมายเหตุ (ถ้ามี)"/>
                                </div>
                                <div class="pos-panel-section">
                                    <div class="pos-inline-actions">
                                        <button id="clear-discount-btn" class="pos-secondary-btn" type="button">ล้างส่วนลด</button>
                                    </div>
                                </div>
                            </div>
                            <div class="pos-right-panel">
                                <div class="pos-cart-head">
                                    <span>จำนวน</span>
                                    <span>รายการ</span>
                                    <span style="text-align:right;">ราคา</span>
                                </div>
                                <div class="js-cart-table-body pos-cart-body"></div>
                                <div class="pos-summary-box">
                                    <div class="pos-summary-row">
                                        <span>ยอดรวม</span>
                                        <span class="js-summary-subtotal">0.00</span>
                                    </div>
                                    <div class="pos-summary-row">
                                        <span>ส่วนลด</span>
                                        <span class="js-summary-discount">0.00</span>
                                    </div>
                                    <div class="pos-summary-row grand">
                                        <span>ยอดชำระ</span>
                                        <span class="js-summary-total">0.00</span>
                                    </div>
                                </div>
                                <button id="to-payment-btn" class="pos-primary-btn" type="button">ต่อไป</button>
                            </div>
                        </div>
                    </section>

                    <!-- 3. ชำระเงิน -->
                    <section id="screen-payment" class="pos-screen">
                        <div class="pos-header-bar">
                            <div class="pos-header-left">
                                <button class="pos-icon-btn pos-menu-btn" type="button" title="เมนู" aria-label="เมนู">
                                    <svg class="pos-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
                                </button>
                                <div class="pos-header-title">3. ชำระเงิน</div>
                            </div>
                        </div>
                        <div class="pos-workspace">
                            <div class="pos-left-panel">
                                <div class="pos-pay-tabs">
                                    <button class="pos-pay-tab active" type="button" data-pay-tab="cash">เงินสด</button>
                                    <button class="pos-pay-tab" type="button" data-pay-tab="transfer">โอน</button>
                                </div>
                                <div id="cash-payment-panel">
                                    <div id="amount-paid-display" class="pos-amount-display">0</div>
                                    <div class="pos-numpad" id="numpad">
                                        <button type="button" data-key="7">7</button>
                                        <button type="button" data-key="8">8</button>
                                        <button type="button" data-key="9">9</button>
                                        <button type="button" data-key="4">4</button>
                                        <button type="button" data-key="5">5</button>
                                        <button type="button" data-key="6">6</button>
                                        <button type="button" data-key="1">1</button>
                                        <button type="button" data-key="2">2</button>
                                        <button type="button" data-key="3">3</button>
                                        <button type="button" class="ac" data-key="clear">AC</button>
                                        <button type="button" data-key="0">0</button>
                                        <button type="button" data-key=".">.</button>
                                    </div>
                                </div>
                                <div id="transfer-payment-panel" class="pos-transfer-panel" hidden="hidden">
                                    <div class="pos-transfer-summary">
                                        <div class="pos-transfer-label">ยอดโอน</div>
                                        <div id="transfer-amount-display" class="pos-transfer-amount">0.00</div>
                                        <div class="pos-transfer-note">ยอดโอนต้องตรงกับยอดชำระ</div>
                                        <input id="transfer-slip-input" type="file" accept="image/*" capture="environment" hidden="hidden"/>
                                        <div id="transfer-slip-preview" class="pos-slip-preview" hidden="hidden">
                                            <img id="transfer-slip-image" alt="สลิปโอนเงิน"/>
                                            <button id="transfer-slip-remove-btn" class="pos-slip-remove" type="button">ลบรูป</button>
                                        </div>
                                        <button id="transfer-slip-btn" class="pos-transfer-slip-action" type="button" hidden="hidden">ถ่ายรูปสลิป</button>
                                    </div>
                                </div>
                                <div id="checkout-error" class="pos-error" hidden="hidden"></div>
                            </div>
                            <div class="pos-right-panel">
                                <div class="pos-cart-head">
                                    <span>จำนวน</span>
                                    <span>รายการ</span>
                                    <span style="text-align:right;">ราคา</span>
                                </div>
                                <div class="js-cart-table-body pos-cart-body"></div>
                                <div class="pos-summary-box">
                                    <div class="pos-summary-row">
                                        <span>ยอดรวม</span>
                                        <span class="js-summary-subtotal">0.00</span>
                                    </div>
                                    <div class="pos-summary-row">
                                        <span>ส่วนลด</span>
                                        <span class="js-summary-discount">0.00</span>
                                    </div>
                                    <div class="pos-summary-row grand">
                                        <span>ยอดชำระ</span>
                                        <span class="js-summary-total">0.00</span>
                                    </div>
                                </div>
                                <button id="pay-btn" class="pos-primary-btn" type="button">ชำระเงิน</button>
                            </div>
                        </div>
                    </section>

                    <!-- 4. สรุปเงินทอน -->
                    <section id="screen-success" class="pos-screen">
                        <div class="pos-header-bar">
                            <div class="pos-header-left">
                                <button class="pos-icon-btn pos-menu-btn" type="button" title="เมนู" aria-label="เมนู">
                                    <svg class="pos-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
                                </button>
                                <div class="pos-header-title">4. สรุปเงินทอน</div>
                            </div>
                        </div>
                        <div class="pos-success-layout">
                            <div class="pos-success-left">
                                <div class="pos-info-row"><span>เลขที่บิล</span><strong id="success-order-number">-</strong></div>
                                <div class="pos-info-row"><span>ยอดรวม</span><strong id="success-subtotal">0.00</strong></div>
                                <div class="pos-info-row"><span>ส่วนลด</span><strong id="success-discount">0.00</strong></div>
                                <div class="pos-info-row"><span>ยอดชำระ</span><strong id="success-total">0.00</strong></div>
                                <div class="pos-info-row"><span>รับเงิน</span><strong id="success-paid">0.00</strong></div>
                            </div>
                            <div class="pos-success-right">
                                <div class="pos-success-card">
                                    <h2>เงินทอน</h2>
                                    <div class="pos-change-amount" id="success-change">0.00</div>
                                    <small>บาท</small>
                                </div>
                                <div style="margin-top:20px; display:flex; flex-direction:column; gap:10px;">
                                    <button id="print-receipt-btn" class="pos-btn pos-btn-secondary pos-btn-block" type="button">พิมพ์ใบเสร็จ</button>
                                    <button id="new-order-btn" class="pos-btn pos-btn-primary pos-btn-block" type="button">ทำรายการใหม่</button>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- ปิดกะ -->
                    <section id="screen-close-session" class="pos-screen pos-auth-screen">
                        <div class="pos-auth-card">
                            <div class="pos-brand">
                                <h1>ปิดกะขาย</h1>
                                <p>นับเงินสดในลิ้นชัก</p>
                            </div>
                            <div id="close-session-error" class="pos-error" hidden="hidden"></div>
                            <form id="close-session-form">
                                <div class="pos-field">
                                    <label class="pos-label" for="closing-cash">เงินสดปิดกะ (บาท)</label>
                                    <input id="closing-cash" class="pos-input" type="number" min="0" step="0.01" required="required"/>
                                </div>
                                <button class="pos-btn pos-btn-primary pos-btn-block" type="submit">ปิดกะ</button>
                                <button id="cancel-close-btn" class="pos-btn pos-btn-secondary pos-btn-block" type="button" style="margin-top:10px;">ยกเลิก</button>
                            </form>
                        </div>
                    </section>

                    <!-- เบิกสินค้า -->
                    <section id="screen-requisition" class="pos-screen">
                        <div class="pos-header-bar">
                            <div class="pos-header-left">
                                <button class="pos-icon-btn pos-menu-btn" type="button" title="เมนู" aria-label="เมนู">
                                    <svg class="pos-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
                                </button>
                                <div class="pos-header-title">เบิกสินค้า</div>
                            </div>
                            <button id="requisition-list-btn" class="pos-header-action" type="button">รายการเบิก</button>
                        </div>
                        <div class="pos-content pos-requisition-content">
                            <div id="requisition-error" class="pos-error" hidden="hidden"></div>
                            <div id="requisition-success" class="pos-success-msg" hidden="hidden"></div>
                            <div class="pos-requisition-page">
                                <section class="pos-requisition-panel pos-requisition-panel--catalog">
                                    <h2 class="pos-panel-heading">เลือกสินค้า</h2>
                                    <div class="pos-search-box pos-search-with-scan pos-search-inline">
                                        <input id="requisition-search" class="pos-search-input" type="search" placeholder="ค้นหาสินค้า รหัส หรือบาร์โค้ด"/>
                                        <button id="requisition-scan-btn" class="pos-barcode-scan-btn" type="button" aria-label="สแกนบาร์โค้ด" title="สแกนบาร์โค้ด">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><line x1="7" y1="12" x2="17" y2="12"/></svg>
                                        </button>
                                    </div>
                                    <div id="requisition-product-list" class="pos-row-list pos-requisition-catalog"></div>
                                    <div id="requisition-products-pagination" class="pos-pagination" hidden="hidden"></div>
                                </section>
                                <section class="pos-requisition-panel pos-requisition-panel--cart">
                                    <h2 class="pos-panel-heading">รายการเบิก</h2>
                                    <div id="requisition-cart-list" class="pos-requisition-cart-lines"></div>
                                    <div class="pos-requisition-cart-footer">
                                        <div class="pos-field pos-requisition-note">
                                            <label class="pos-label" for="requisition-note">หมายเหตุ</label>
                                            <input id="requisition-note" class="pos-input" type="text" placeholder="หมายเหตุ (ถ้ามี)"/>
                                        </div>
                                        <button id="submit-requisition-btn" class="pos-primary-btn pos-btn-block pos-requisition-submit" type="button" disabled="disabled">ส่งคำขอเบิก</button>
                                    </div>
                                </section>
                            </div>
                        </div>
                    </section>

                    <!-- รายการเบิก -->
                    <section id="screen-requisition-list" class="pos-screen">
                        <div class="pos-header-bar">
                            <div class="pos-header-left">
                                <button class="pos-icon-btn pos-menu-btn" type="button" title="เมนู" aria-label="เมนู">
                                    <svg class="pos-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
                                </button>
                                <div class="pos-header-title">ประวัติการเบิก</div>
                            </div>
                            <button id="requisition-new-btn" class="pos-header-action" type="button">เบิกใหม่</button>
                        </div>
                        <div class="pos-content">
                            <div class="pos-filter-bar">
                                <label class="pos-filter-label" for="requisition-date">วันที่</label>
                                <input id="requisition-date" class="pos-date-input" type="date"/>
                                <button id="requisition-filter-btn" class="pos-filter-btn" type="button">ค้นหา</button>
                            </div>
                            <div id="requisition-list-error" class="pos-error" hidden="hidden"></div>
                            <div id="requisition-list-container" class="pos-row-list pos-order-list"></div>
                            <div id="requisition-list-pagination" class="pos-pagination" hidden="hidden"></div>
                        </div>
                    </section>

                    <!-- รายละเอียดการเบิก -->
                    <section id="screen-requisition-detail" class="pos-screen">
                        <div class="pos-header-bar">
                            <div class="pos-header-left">
                                <button id="requisition-detail-back-btn" class="pos-icon-btn" type="button" aria-label="กลับ">
                                    <svg class="pos-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
                                </button>
                                <div class="pos-header-title">รายละเอียดการเบิก</div>
                            </div>
                        </div>
                        <div class="pos-content">
                            <div id="requisition-detail-error" class="pos-error" hidden="hidden"></div>
                            <div id="requisition-detail-container"></div>
                        </div>
                    </section>

                    <!-- สต็อกสินค้า -->
                    <section id="screen-stock" class="pos-screen">
                        <div class="pos-header-bar">
                            <div class="pos-header-left">
                                <button class="pos-icon-btn pos-menu-btn" type="button" title="เมนู" aria-label="เมนู">
                                    <svg class="pos-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
                                </button>
                                <div class="pos-header-title">สต็อกสินค้า</div>
                            </div>
                        </div>
                        <div class="pos-content pos-stock-content">
                            <div class="pos-search-box pos-stock-search">
                                <input id="stock-search" class="pos-search-input" type="search" placeholder="ค้นหาสินค้า"/>
                            </div>
                            <div id="stock-list-container" class="pos-row-list pos-stock-list"></div>
                            <div id="stock-pagination" class="pos-pagination" hidden="hidden"></div>
                        </div>
                    </section>

                    <!-- ประวัติการขาย -->
                    <section id="screen-sales-history" class="pos-screen">
                        <div class="pos-header-bar">
                            <div class="pos-header-left">
                                <button class="pos-icon-btn pos-menu-btn" type="button" title="เมนู" aria-label="เมนู">
                                    <svg class="pos-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
                                </button>
                                <div class="pos-header-title">ประวัติการขาย</div>
                            </div>
                        </div>
