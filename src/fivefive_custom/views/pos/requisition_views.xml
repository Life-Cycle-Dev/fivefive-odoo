<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_five_five_store_requisition_list" model="ir.ui.view">
        <field name="name">five.five.store.requisition.list</field>
        <field name="model">five.five.store.requisition</field>
        <field name="arch" type="xml">
            <list default_order="requested_at desc">
                <field name="number"/>
                <field name="requested_at"/>
                <field name="store_id"/>
                <field name="pos_user_id"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'submitted'"
                    decoration-warning="state == 'prepared'"
                    decoration-primary="state == 'received'"
                    decoration-success="state == 'done'"
                    decoration-muted="state == 'cancelled'"/>
                <field name="movement_count" string="Movements"/>
                <field name="warehouse_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_five_five_store_requisition_form" model="ir.ui.view">
        <field name="name">five.five.store.requisition.form</field>
        <field name="model">five.five.store.requisition</field>
        <field name="arch" type="xml">
            <form string="Stock Requisition">
                <header>
                    <button name="action_open_allocate_wizard" type="object" string="Allocate Stock" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_open_complete_wizard" type="object" string="Complete &amp; Deduct Stock" class="btn-primary" invisible="state != 'received'"/>
                    <button name="action_open_receive_wizard" type="object" string="Mark Received" class="btn-secondary" invisible="state != 'prepared'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state in ['done', 'cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="submitted,prepared,received,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="number" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Request">
                            <field name="store_id" readonly="1"/>
                            <field name="warehouse_ids" widget="many2many_tags" readonly="1"/>
                            <field name="warehouse_id" readonly="1" invisible="warehouse_ids"/>
                            <field name="pos_user_id" readonly="1"/>
                            <field name="session_id" readonly="1"/>
                            <field name="note" readonly="1"/>
                        </group>
                        <group string="Timeline">
                            <field name="requested_at" readonly="1"/>
                            <field name="prepared_at" readonly="1"/>
                            <field name="received_at" readonly="1"/>
                            <field name="done_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Requested Items">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="product_variant_id"/>
                                    <field name="requested_qty"/>
                                    <field name="allocated_qty"/>
                                    <field name="received_qty"/>
                                    <field name="deducted_qty"/>
                                    <field name="qty_variance_reason"/>
                                </list>
                            </field>
                        </page>
                        <page string="Inventory Movements">
                            <field name="movement_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="product_variant_id"/>
                                    <field name="warehouse_id" string="Warehouse"/>
                                    <field name="lot_number"/>
                                    <field name="quantity"/>
                                    <field name="state" widget="badge"/>
                                    <field name="transfer_cost_thb" optional="hide"/>
                                    <field name="prepared_at" optional="hide"/>
                                    <field name="done_at" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_five_five_store_requisition_allocate_wizard_form" model="ir.ui.view">
        <field name="name">five.five.store.requisition.allocate.wizard.form</field>
        <field name="model">five.five.store.requisition.allocate.wizard</field>
        <field name="arch" type="xml">
            <form string="Allocate Stock">
                <group>
                    <field name="requisition_id" readonly="1"/>
                    <field name="store_id" readonly="1"/>
                    <field name="warehouse_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
                <group string="Lot Allocations" invisible="not warehouse_ids">
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="requisition_line_id" column_invisible="1"/>
                            <field name="product_variant_id" string="Product Variant" readonly="1"/>
                            <field name="requested_qty" string="Requested" readonly="1"/>
                            <field name="warehouse_inventory_id" column_invisible="1"/>
                            <field name="warehouse_id" string="Warehouse" readonly="1"/>
                            <field name="lot_number" string="Lot Number" readonly="1"/>
                            <field name="quality_note" string="Quality Note" readonly="1"/>
                            <field name="available_quantity" string="Available" readonly="1"/>
                            <field name="unit_cost_thb" string="Unit Cost" readonly="1"/>
                            <field name="lot_total_cost_thb" string="Lot Cost" readonly="1" optional="hide"/>
                            <field name="quantity" string="Allocate Qty"/>
                            <field name="allocation_cost_thb" string="Alloc. Cost" readonly="1"/>
                        </list>
                    </field>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Create Movements" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_five_five_store_requisition_receive_wizard_form" model="ir.ui.view">
        <field name="name">five.five.store.requisition.receive.wizard.form</field>
        <field name="model">five.five.store.requisition.receive.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Received Quantities">
                <group>
                    <field name="requisition_id" readonly="1"/>
                </group>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="requisition_line_id" column_invisible="1"/>
                        <field name="product_variant_id" readonly="1"/>
                        <field name="requested_qty" readonly="1"/>
                        <field name="allocated_qty" readonly="1"/>
                        <field name="received_qty"/>
                        <field name="qty_variance_reason" placeholder="Required if received qty differs from allocated qty"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm Received" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_five_five_store_requisition_complete_wizard_form" model="ir.ui.view">
        <field name="name">five.five.store.requisition.complete.wizard.form</field>
        <field name="model">five.five.store.requisition.complete.wizard</field>
        <field name="arch" type="xml">
            <form string="Complete &amp; Deduct Stock">
                <group>
                    <field name="requisition_id" readonly="1"/>
                </group>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="requisition_line_id" column_invisible="1"/>
                        <field name="product_variant_id" readonly="1"/>
                        <field name="requested_qty" readonly="1"/>
                        <field name="received_qty" readonly="1"/>
                        <field name="allocated_qty" readonly="1"/>
                        <field name="deduct_qty"/>
                        <field name="qty_variance_reason" readonly="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Complete &amp; Deduct" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_five_five_inventory_movement_list" model="ir.ui.view">
        <field name="name">five.five.inventory.movement.list</field>
        <field name="model">five.five.inventory.movement</field>
        <field name="arch" type="xml">
            <list default_order="id desc">
                <field name="name"/>
                <field name="requisition_id"/>
                <field name="store_id"/>
                <field name="product_variant_id"/>
                <field name="quantity"/>
                <field name="state" widget="badge"/>
                <field name="lot_number" optional="hide"/>
                <field name="warehouse_id" optional="hide"/>
                <field name="transfer_cost_thb" optional="hide"/>
                <field name="prepared_at" optional="hide"/>
                <field name="done_at" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_five_five_inventory_movement_form" model="ir.ui.view">
        <field name="name">five.five.inventory.movement.form</field>
        <field name="model">five.five.inventory.movement</field>
        <field name="arch" type="xml">
            <form string="Inventory Movement">
                <header>
                    <button name="action_done" type="object" string="Done" class="btn-primary" invisible="state != 'prepared'"/>
                    <field name="state" widget="statusbar" statusbar_visible="prepared,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Movement">
                            <field name="requisition_id" readonly="1"/>
                            <field name="warehouse_id" readonly="1"/>
                            <field name="store_id" readonly="1"/>
                            <field name="product_variant_id" readonly="1"/>
                            <field name="lot_number" readonly="1"/>
                            <field name="quality_note" readonly="1"/>
                        </group>
                        <group string="Details">
                            <field name="quantity" readonly="1"/>
                            <field name="transfer_cost_thb" readonly="1"/>
                            <field name="prepared_at" readonly="1"/>
                            <field name="done_at" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_five_five_store_requisition" model="ir.actions.act_window">
        <field name="name">Stock Requisitions</field>
        <field name="res_model">five.five.store.requisition</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_five_five_inventory_movement" model="ir.actions.act_window">
        <field name="name">Inventory Movements</field>
        <field name="res_model">five.five.inventory.movement</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
