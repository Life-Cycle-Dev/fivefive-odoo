<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_five_five_inventory_model_form" model="ir.ui.view">
        <field name="name">five.five.inventory.form</field>
        <field name="model">five.five.inventory</field>
        <field name="arch" type="xml">
            <form class="ff_five_five_inventory_form">
                <header>
                    <button
                        name="action_open_edit_costs"
                        type="object"
                        string="Edit Costs"
                        class="btn-secondary"
                        invisible="not product_convert_id"
                    />
                    <button
                        name="action_open_transfer_wizard"
                        type="object"
                        string="Transfer to Store"
                        class="btn-primary"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <div class="text-muted">Inventory</div>
                        <h1>
                            <field name="product_variant_id" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Stock">
                            <field name="warehouse_id" readonly="1"/>
                            <field name="lot_number" readonly="1"/>
                            <field name="quantity" readonly="1"/>
                            <field name="quality_note" readonly="1"/>
                        </group>
                        <group string="Cost">
                            <field name="cost_as_of_date" readonly="1"/>
                            <field name="total_cost_thb" readonly="1"/>
                            <field name="cost_summary" readonly="1" widget="text"/>
                        </group>
                    </group>

                    <field name="product_convert_id" invisible="1"/>
                </sheet>
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids" options="{'post_refresh': 'recipients'}"/>
                </chatter>
            </form>
        </field>
    </record>

    <record id="action_five_five_inventory_model" model="ir.actions.act_window">
        <field name="name">Inventory</field>
        <field name="res_model">five.five.inventory</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_five_five_inventory_model_search"/>
        <field name="context">{'create': False}</field>
    </record>

    <record id="action_five_five_inventory_transfer_to_store" model="ir.actions.server">
        <field name="name">Transfer to Store</field>
        <field name="model_id" ref="model_five_five_inventory"/>
        <field name="binding_model_id" ref="model_five_five_inventory"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_open_transfer_wizard()</field>
    </record>
</odoo>
