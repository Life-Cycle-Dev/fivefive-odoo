<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_five_five_store_inventory_convert_wizard_form" model="ir.ui.view">
        <field name="name">five.five.store.inventory.convert.wizard.form</field>
        <field name="model">five.five.store.inventory.convert.wizard</field>
        <field name="arch" type="xml">
            <form string="Convert Product">
                <group>
                    <field name="store_id" readonly="1"/>
                </group>
                <group string="Convert store stock to another product variant">
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom">
                            <field
                                name="store_inventory_id"
                                string="From Stock"
                                domain="[('store_id', '=', parent.store_id), ('quantity', '&gt;', 0)]"
                                options="{'no_create': True}"
                            />
                            <field name="source_product_variant_id" string="From Product" readonly="1"/>
                            <field name="quantity_on_hand" readonly="1"/>
                            <field name="weight_on_hand" readonly="1" optional="hide"/>
                            <field name="target_product_variant_id" string="To Product"/>
                            <field name="convert_qty" string="Convert Qty"/>
                            <field name="target_lot_number" string="Target Lot No."/>
                        </list>
                    </field>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Convert" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
