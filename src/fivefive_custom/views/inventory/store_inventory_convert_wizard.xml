<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_five_five_store_inventory_convert_wizard_form" model="ir.ui.view">
        <field name="name">five.five.store.inventory.convert.wizard.form</field>
        <field name="model">five.five.store.inventory.convert.wizard</field>
        <field name="arch" type="xml">
            <form string="Convert Product">
                <group>
                    <field name="store_id" readonly="1"/>
                    <field name="as_of_date"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="product_variant_id"/>
                        <field name="lot_number"/>
                        <field name="item_number"/>
                        <field name="brand_id"/>
                        <field name="description_id"/>
                        <field name="container_number"/>
                        <field name="quantity"/>
                        <field name="weight_per_qty"/>
                        <field name="quality_note"/>
                        <field name="quality_image" widget="image"/>
                        <field name="cost_summary" readonly="1"/>
                        <field name="total_cost_thb" readonly="1"/>
                    </list>
                </field>
                <group>
                    <field name="total_cost_thb" readonly="1"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
