<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_five_five_warehouse_transfer_wizard_form" model="ir.ui.view">
        <field name="name">five.five.warehouse.transfer.wizard.form</field>
        <field name="model">five.five.warehouse.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="Transfer to Store">
                <group>
                    <field name="lock_store" invisible="1"/>
                    <field name="lock_warehouse" invisible="1"/>
                    <field name="available_product_variant_ids" invisible="1"/>
                    <field name="warehouse_id" readonly="lock_warehouse"/>
                    <field name="store_id" readonly="lock_store"/>
                    <field
                        name="product_variant_id"
                        domain="[('id', 'in', available_product_variant_ids)]"
                        readonly="not warehouse_id or not store_id"
                    />
                </group>
                <group
                    string="Items to Transfer"
                    invisible="not warehouse_id or not store_id or not product_variant_id"
                >
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0" class="ff_five_five_transfer_wizard_list">
                            <field name="inventory_id" column_invisible="1" force_save="1" readonly="1"/>
                            <field name="lot_number" string="Lot Number" width="150px" readonly="1"/>
                            <field name="product_variant_id" string="Product Variant" column_invisible="1"/>
                            <field name="quality_note" string="Quality Note" width="120px" readonly="1"/>
                            <field name="available_quantity" string="Quantity" width="90px" readonly="1"/>
                            <field name="unit_cost_thb" string="Cost per Unit (THB)" width="160px" readonly="1"/>
                            <field name="quantity" string="Transfer Quantity" width="150px" force_save="1"/>
                            <field name="transfer_cost_thb" string="Transfer Cost (THB)" width="160px" readonly="1"/>
                        </list>
                    </field>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Transfer" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
