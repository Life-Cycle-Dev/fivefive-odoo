<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_five_five_store_inventory_adjust_wizard_form" model="ir.ui.view">
        <field name="name">five.five.store.inventory.adjust.wizard.form</field>
        <field name="model">five.five.store.inventory.adjust.wizard</field>
        <field name="arch" type="xml">
            <form string="Adjust Store Inventory">
                <group>
                    <field name="store_id" readonly="1"/>
                    <field name="reason" placeholder="ระบุเหตุผลในการปรับสต็อก (จำเป็น)"/>
                </group>
                <group string="Products">
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="store_inventory_id" column_invisible="1"/>
                            <field name="product_variant_id" readonly="1"/>
                            <field name="lot_number" readonly="1"/>
                            <field name="quantity_on_hand" readonly="1"/>
                            <field name="adjustment_type"/>
                            <field name="quantity"/>
                        </list>
                    </field>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Apply Adjustments" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_five_five_store_inventory_adjustment_list" model="ir.ui.view">
        <field name="name">five.five.store.inventory.adjustment.list</field>
        <field name="model">five.five.store.inventory.adjustment</field>
        <field name="arch" type="xml">
            <list default_order="adjusted_at desc, id desc" create="0" edit="0" delete="0">
                <field name="adjusted_at"/>
                <field name="store_id"/>
                <field name="product_variant_id"/>
                <field name="lot_number"/>
                <field name="adjustment_type"/>
                <field name="quantity_before"/>
                <field name="quantity_change"/>
                <field name="quantity_after"/>
                <field name="reason"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_five_five_store_inventory_adjustment_form" model="ir.ui.view">
        <field name="name">five.five.store.inventory.adjustment.form</field>
        <field name="model">five.five.store.inventory.adjustment</field>
        <field name="arch" type="xml">
            <form string="Store Inventory Adjustment" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="store_id" readonly="1"/>
                            <field name="product_variant_id" readonly="1"/>
                            <field name="lot_number" readonly="1"/>
                            <field name="adjustment_type" readonly="1"/>
                            <field name="reason" readonly="1"/>
                        </group>
                        <group>
                            <field name="quantity_before" readonly="1"/>
                            <field name="quantity_change" readonly="1"/>
                            <field name="quantity_after" readonly="1"/>
                            <field name="cost_before" readonly="1"/>
                            <field name="cost_after" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="adjusted_at" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_five_five_store_inventory_adjustment" model="ir.actions.act_window">
        <field name="name">Store Inventory Adjustments</field>
        <field name="res_model">five.five.store.inventory.adjustment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
