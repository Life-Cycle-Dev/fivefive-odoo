        <field name="active" eval="False"/>
    </record>

    <!-- แอpp แยกใน App Switcher -->
    <menuitem id="menu_five_five_orders_model" name="Purchase Orders" sequence="10"/>
    <menuitem id="menu_five_five_supplier_model" name="Supplier" sequence="20"/>
    <menuitem id="menu_five_five_product_model" name="Product" sequence="30"/>
    <menuitem id="menu_five_five_inventory_model" name="Inventory" sequence="40"/>
    <menuitem
        id="menu_five_five_store_pos_model"
        name="POS"
        sequence="50"
        action="action_five_five_store_pos_order"
    />

    <!-- Orders -->
    <menuitem
        id="menu_five_five_purchase_order_model"
        name="Purchase Orders"
        parent="menu_five_five_orders_model"
        action="action_five_five_purchase_order_model"
        sequence="1"
    />

    <!-- Supplier -->
    <menuitem
        id="menu_five_five_supplier_sub_menu"
        name="Suppliers"
        parent="menu_five_five_supplier_model"
        action="action_five_five_supplier_model"
        sequence="1"
